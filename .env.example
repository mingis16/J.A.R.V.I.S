# Anthropic API key for the assistant / orchestrator brain.
ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a single workspace — the API then
# rejects every request with "not scoped to a workspace" until this is set.
# Find it at console.anthropic.com under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# MetaTrader 5 account credentials for the trading bot.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 isn't auto-detected.
MT5_TERMINAL_PATH=

# Hard safety gate. The trading bot will refuse to place real orders unless
# execution.live_trading is true in config/config.yaml AND this var is set
# to exactly: YES_I_UNDERSTAND_THE_RISK
# Leave unset/empty to stay in paper (simulated) mode.
JARVIS_CONFIRM_LIVE=
